[Unit]
Description=Fan Control HTTP API (reserved for web UI manual control)
Documentation=manual
After=fan-control.service
# 说明：本服务【默认不启用】。需要页面接入时执行：
#   systemctl enable --now fan-api
# 默认只监听 127.0.0.1:8899，避免 NAS 上多开无鉴权端口。

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/fan-api.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
